{
  "enabled": {
    "type": "bool",
    "description": "启用第三方平台自主活动（开发阶段默认关闭）",
    "default": false
  },
  "provider_id": {
    "type": "string",
    "description": "规划与阅读使用的模型 Provider ID",
    "default": ""
  },
  "public_persona": {
    "type": "text",
    "description": "公共浏览和表达的人格设定，不填私人记忆",
    "default": ""
  },
  "timezone": {
    "type": "string",
    "description": "日程时区",
    "default": "Asia/Shanghai"
  },
  "windows": {
    "type": "list",
    "description": "允许浏览的时间窗，可重叠或跨午夜",
    "default": [
      "10:00-11:00",
      "20:00-21:00"
    ]
  },
  "daily_rounds": {
    "type": "int",
    "description": "每天最多计划多少轮，可为0",
    "default": 2
  },
  "daily_limit": {
    "type": "int",
    "description": "所有平台共用每日行为上限",
    "default": 20
  },
  "minute_limit": {
    "type": "int",
    "description": "每分钟行为上限",
    "default": 2
  },
  "share_min_score": {
    "type": "float",
    "description": "所有平台共用最低分享评分",
    "default": 8.0
  },
  "control_umos": {
    "type": "list",
    "description": "允许用自然语言管理日程的私聊UMO",
    "default": []
  },
  "memory_enabled": {
    "type": "bool",
    "description": "将公开阅读记录写入并行记忆分支",
    "default": false
  },
  "platforms": {
    "type": "object",
    "description": "平台账号策略（也可在工作台添加）",
    "items": {
      "bilibili": {
        "type": "object",
        "description": "B站",
        "items": {
          "enabled": {
            "type": "bool",
            "description": "启用平台",
            "default": false
          },
          "accounts": {
            "type": "object",
            "description": "账号策略，由工作台管理",
            "items": {}
          }
        }
      },
      "xiaoheihe": {
        "type": "object",
        "description": "小黑盒",
        "items": {
          "enabled": {
            "type": "bool",
            "description": "启用平台",
            "default": false
          },
          "accounts": {
            "type": "object",
            "description": "账号策略，由工作台管理",
            "items": {}
          }
        }
      }
    }
  }
}